// =============================================================================
// EnadIA TECH - Schema for PostgreSQL (Supabase) with Multi-Tenancy
// =============================================================================
// Multi-tenancy: The `instance` column isolates users/responses per deployment.
//   - instance = 'ENADIA'  → Deployment 1 (EnadIA)
//   - instance = 'FECAP'   → Deployment 2 (EnadIA Fecap)
// Shared content (questions, microareas, elements) has NO instance column.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── MODELS ──────────────────────────────────────────

model User {
  id            String   @id // CUID generated by app
  email         String
  name          String
  password      String
  role          String   @default("ALUNO") // MASTER, PROFESSOR, ALUNO
  ra            String?  
  avatar        String?
  active        Boolean  @default(true)
  lastLogin     DateTime?
  instance      String   @default("ENADIA") // Multi-tenancy

  // Student fields
  curso         String?
  periodo       Int?
  modalidade    String?  @default("PRESENCIAL")

  // Professor fields
  disciplina    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  responses          StudentResponse[]
  authoredQuestions   Question[]       @relation("QuestionAuthor")
  validatedQuestions Question[]       @relation("QuestionValidator")
  essayAnswers       EssayAnswer[]
  localResponses     LocalQuestionResponse[]

  @@unique([email, instance]) // Same email allowed across instances
  @@unique([ra, instance])     // Same RA allowed across instances
  @@index([instance])
  @@index([role, instance])
}

model Microarea {
  id          String   @id // CUID
  name        String   @unique
  code        String   @unique
  macroarea   String
  description String
  color       String   @default("#3b82f6")
  order       Int      @default(0)
  elements    Element[]
  questions   Question[]
  createdAt   DateTime @default(now())
}

model Element {
  id           String    @id // CUID
  code         String    @unique
  name         String
  description  String
  skillLevel   String    @default("compreensão")
  microareaId  String
  microarea    Microarea  @relation(fields: [microareaId], references: [id], onDelete: Cascade)
  order        Int       @default(0)
  questions    Question[]
  createdAt    DateTime  @default(now())
}

model Question {
  id              String   @id // CUID
  code            String   @unique
  type            String   @default("OBJETIVA")
  statement       String
  context         String?
  correctAnswer   String
  explanation     String?
  difficulty      String   @default("médio")

  triA            Float?
  triB            Float?
  triC            Float?
  triCalibrated   Boolean  @default(false)

  source          String   @default("elaborada")
  sourceYear      Int?
  enadeId         String?

  microareaId     String
  microarea       Microarea  @relation(fields: [microareaId], references: [id])
  elementId       String?
  element         Element?   @relation(fields: [elementId], references: [id])
  authorId        String?
  author          User?     @relation("QuestionAuthor", fields: [authorId], references: [id])
  validatorId     String?
  validator       User?     @relation("QuestionValidator", fields: [validatorId], references: [id])

  status          String   @default("RASCUNHO")

  alternatives    Alternative[]
  responses       StudentResponse[]
  simuladoConfigs SimuladoConfig[]
  tags            QuestionTag[]
  essayAnswers    EssayAnswer[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([microareaId])
  @@index([status])
}

model Alternative {
  id         String   @id // CUID
  letter     String
  text       String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([questionId])
}

model Simulado {
  id            String   @id // CUID
  title         String
  description   String?
  type          String   @default("LIVRE")
  phase         Int?
  timeLimit     Int?
  questionCount Int      @default(10)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  configs       SimuladoConfig[]
  responses     StudentResponse[]
}

model SimuladoConfig {
  id         String   @id // CUID
  simuladoId String
  simulado   Simulado @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int      @default(0)
}

model StudentResponse {
  id            String    @id // CUID
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id])
  simuladoId    String?
  simulado      Simulado? @relation(fields: [simuladoId], references: [id])
  answer        String
  isCorrect     Boolean?
  responseTime  Int?
  instance      String    @default("ENADIA")
  createdAt     DateTime  @default(now())

  @@index([userId, instance])
  @@index([questionId])
  @@index([simuladoId])
}

model EssayAnswer {
  id            String    @id // CUID
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id])
  simuladoId    String?
  answer        String
  aiFeedback    String?
  aiScore       Float?
  instance      String    @default("ENADIA")
  createdAt     DateTime  @default(now())

  @@index([userId, instance])
}

model QuestionTag {
  id         String   @id // CUID
  name       String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id        String   @id // CUID
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Local Bank Question model (for in-memory bank questions) ───

model LocalQuestionResponse {
  id            String   @id // CUID
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  questionBankId String
  topic         String
  macroarea     String
  difficulty    String?
  answer        String
  correctAnswer String
  isCorrect     Boolean
  responseTime  Int?
  instance      String   @default("ENADIA")
  createdAt     DateTime @default(now())

  @@index([userId, instance])
  @@index([topic, instance])
}
